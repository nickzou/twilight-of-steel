{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        { "slug": "base", "name": "Base", "color": "#ffffff" },
        { "slug": "contrast", "name": "Contrast", "color": "#111111" },
        { "slug": "accent", "name": "Accent", "color": "#2563eb" }
      ]
    },
    "typography": {
      "fontSizes": [{ "slug": "small", "name": "Small", "size": "0.875rem" }],
      "fontFamilies": [
        {
          "slug": "firjar",
          "name": "Firjar",
          "fontFamily": "Firjar, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Firjar",
              "fontStyle": "normal",
              "fontWeight": "100 800",
              "fontStretch": "75% 125%",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/firjar-latin-wdth-wght.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Firjar",
              "fontStyle": "normal",
              "fontWeight": "100 800",
              "fontStretch": "75% 125%",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/firjar-latin-ext-wdth-wght.woff2"],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
            }
          ]
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": { "left": "1.5rem", "right": "1.5rem" }
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      }
    }
  }
}
