{
  "name": "twilight-of-steel",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "typecheck": "tsc",
    "build": "wp-scripts build --webpack-src-dir=plugins/twilight-of-steel-core/src --output-path=plugins/twilight-of-steel-core/build --blocks-manifest",
    "start": "wp-scripts start --webpack-src-dir=plugins/twilight-of-steel-core/src --output-path=plugins/twilight-of-steel-core/build --blocks-manifest",
    "postinstall": "node scripts/vendor.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wordpress/block-editor": "20.0.0",
    "@wordpress/blocks": "17.1.0",
    "@wordpress/components": "44.0.0",
    "@wordpress/data": "11.1.0",
    "@wordpress/element": "10.1.0",
    "@wordpress/i18n": "7.1.0",
    "@wordpress/scripts": "37.1.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "alpinejs": "3.17.5",
    "lucide-static": "1.68.0"
  }
}
